node_modules/

# Expo & Metro
.expo/
dist/
web-build/
.metro-health-check*

# Native build folders
/android/
/ios/
*.apk
*.aab

# Git & IDE
.git/
.idea/
.vscode/
.claude/

# Temporary files
*.log
*.tmp
*.tar.gz
